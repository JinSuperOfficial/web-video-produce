{
  "name": "web-video-produce",
  "version": "1.0.0",
  "private": true,
  "description": "用代码做视频：Remotion / Canvas / Three.js + edge-tts 配音 + FFmpeg 合成",
  "scripts": {
    "doctor": "python3 scripts/wvp.py doctor",
    "doctor:preview": "python3 scripts/wvp.py doctor --preview 6",
    "render": "python3 scripts/wvp.py render",
    "render:sample": "python3 scripts/wvp.py render --scale 0.5 --frames 0-60 --out output/sample.mp4",
    "timeline": "python3 scripts/wvp.py timeline --words",
    "timeline:audio": "python3 scripts/wvp.py timeline --verify-audio",
    "check": "bash scripts/check_env.sh",
    "validate": "python3 scripts/validate.py",
    "tts": "python3 scripts/tts_edge.py --script examples/script.intro10s.json --outdir public/voice --voice zh-CN-XiaoxiaoNeural --rate +5% --fps 30 --normalize",
    "tts:api": "python3 scripts/tts_edge.py --script examples/script.intro10s.json --outdir public/voice --fps 30 --engine voicecraft --tts-base-url https://tts.jinsuper.cn/v1 --voice zh-CN-XiaoxiaoNeural --rate +5%",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts WebVideo output/frame.png --frame=120",
    "showcase": "remotion still src/index.ts MotionShowcase output/showcase.png --frame=150",
    "mux": "bash scripts/mux.sh --video output/video_silent.mp4 --audio public/voice/vo.mp3 --out output/final.mp4",
    "edit:plan": "python3 scripts/vedit.py plan --edl examples/edit-plan.example.json",
    "edit": "python3 scripts/vedit.py build --edl examples/edit-plan.example.json",
    "edit:probe": "python3 scripts/vedit.py probe assets/sample/clip_a.mp4 assets/sample/clip_b.mp4 assets/sample/clip_c.mp4",
    "edit:transitions": "python3 scripts/vedit.py transitions",
    "assets": "bash scripts/make_sample_assets.sh",
    "cover": "remotion still src/index.ts Cover output/cover.png",
    "browser": "remotion browser ensure",
    "build": "remotion bundle src/index.ts",
    "bgm": "python3 scripts/make_bgm.py --seconds 32 --out assets/bgm.mp3",
    "sfx": "python3 scripts/make_sfx.py",
    "audition": "python3 scripts/tts_audition.py --outdir output/voice_samples --rate +5%",
    "capture": "node scripts/capture_frames.mjs --html templates/html-gsap/index.html --outdir frames --fps 30 --seconds 12"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.0",
    "@remotion/fonts": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-sc": "^5.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
