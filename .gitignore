public/sfx/
public/fonts/

# demo 大素材（用 scripts/make_sample_assets.sh 重新生成）
assets/sample/*.mp4
assets/sample/bgm.mp3

# 杂项
*.log
.DS_Store


# 给AI参考的，一般放参考项目，没有直接抄的!
ref/
ref.tmp/
